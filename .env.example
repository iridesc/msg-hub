# ── 运行期 ──────────────────────────────────────────────
TZ=Asia/Shanghai

# ── 管理面凭据（必填）──────────────────────────────────
# Basic 认证用的管理员账号。**必填**：HTTP 模式启动时会检查，没设置直接拒绝启动。
# 浏览器访问 dashboard 时弹框输入这对凭据；也能直接调 REST 接口。
# 生成密码：openssl rand -hex 24
MSG_HUB_ADMIN_USER=admin
MSG_HUB_ADMIN_PASSWORD=

# ── 调用面凭据（可选）────────────────────────────────
# API Token 不在这里配！它存在数据目录的 state.json 里，通过 dashboard 的
# 「API Token」页签生成/禁用/删除，或直接手改 state.json。
# 不建 token 也能用：管理员凭据本身就够发消息。
# token 只能发消息，不能管理渠道、不能看日志。

# 端口绑定地址：默认只绑本机；要让同网段其他系统调用就改成 0.0.0.0 或具体内网 IP
MSG_HUB_BIND=127.0.0.1
# 允许的 Host 头（DNS rebinding 防护）；跨主机访问时要把访问用的 IP/域名加进来，否则 421
MSG_HUB_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,msg-hub:*,[::1]:*
# Dashboard（/dashboard）是否开放；它能启停/删除渠道，介意就设 0
MSG_HUB_DASHBOARD=1
# 单个插件子进程超时（秒）
MSG_HUB_PLUGIN_TIMEOUT=20
MSG_HUB_LOG_LEVEL=INFO

# ── 构建期 ──────────────────────────────────────────────
# 国内构建可改为 https://mirrors.aliyun.com/pypi/simple
PIP_INDEX_URL=https://pypi.org/simple
