# ── 运行期 ──────────────────────────────────────────────
TZ=Asia/Shanghai
# MCP(/mcp) 与 REST(/api) 的 Bearer 令牌。留空 = 不鉴权（仅本机调试用）
# 生成：openssl rand -hex 24
MSG_HUB_TOKEN=
# 允许的 Host 头（DNS rebinding 防护）
MSG_HUB_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,msg-hub:*,[::1]:*
# 单个插件子进程超时（秒）
MSG_HUB_PLUGIN_TIMEOUT=20
MSG_HUB_LOG_LEVEL=INFO

# ── 构建期 ──────────────────────────────────────────────
# 国内构建可改为 https://mirrors.aliyun.com/pypi/simple
PIP_INDEX_URL=https://pypi.org/simple
